global-exclude *
include pyproject.toml MANIFEST.in packaging/README.md
include src/dixi_spec_kit/__init__.py src/dixi_spec_kit/__main__.py
include src/dixi_spec_kit/cli.py src/dixi_spec_kit/core.py src/dixi_spec_kit/filesystem.py
include src/dixi_spec_kit/locales/es.json src/dixi_spec_kit/locales/en.json
include src/dixi_spec_kit/resources/project.es.json src/dixi_spec_kit/resources/project.en.json
include src/dixi_spec_kit/workflows.py src/dixi_spec_kit/upgrade.py src/dixi_spec_kit/extensions.py
include src/dixi_spec_kit/LICENSE
include src/dixi_spec_kit/resources/claude/es/*.md src/dixi_spec_kit/resources/claude/en/*.md
include src/dixi_spec_kit/resources/codex/es/*.md src/dixi_spec_kit/resources/codex/en/*.md
include src/dixi_spec_kit/resources/profiles.json
include src/dixi_spec_kit/resources/hooks/*.py
include src/dixi_spec_kit/resources/claude/es/agents/*.md src/dixi_spec_kit/resources/claude/en/agents/*.md
recursive-include src/dixi_spec_kit/resources/templates *.md *.yaml *.json
include src/dixi_spec_kit/resources/workflows.json src/dixi_spec_kit/resources/workflows.es.json src/dixi_spec_kit/resources/workflows.en.json
